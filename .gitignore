# Angular / Node
###############################################################################
# Build artefacts
**/dist/
**/out-tsc/
**/.angular/

# Dependencies
**/node_modules/

# Package-lock (keep yarn.lock if using Yarn, remove one if not needed)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment files
.env
.env.*
!.env.example

# TypeScript cache
*.tsbuildinfo

# Angular cache
**/.ng/

# Test coverage
**/coverage/
**/e2e/test-output/

