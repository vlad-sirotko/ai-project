*.user
*.suo
*.userosscache
*.userprefs
.vs/
.idea/
*.sln.DotSettings.user

# NuGet
*.nupkg
*.snupkg
**/packages/
!**/packages/build/
nuget.config.local

# EF Core SQLite database (runtime)
*.db
*.db-shm
*.db-wal

# Published output
**/publish/

# Uploaded files (runtime)
uploads/

# Secrets / env overrides
**/appsettings.Production.json
**/appsettings.*.local.json
**/*.pfx
**/*.p12

